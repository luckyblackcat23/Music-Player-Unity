<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MusicPlayer/MusicPlayerStyling.uss?fileID=7433441132597879392&amp;guid=e31be3d781b4572418858f823860acfb&amp;type=3#MusicPlayerStyling"/>
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="Black" style="flex-grow: 1; position: absolute; background-color: rgb(0, 0, 0); flex-shrink: 0; right: 0; left: 0; bottom: 0; top: 0; display: none;"/>
        <ui:VisualElement name="Background" class="FocusShaderBackground" style="flex-grow: 1; -unity-material: url(&quot;project://database/Assets/MusicPlayer/Shaders/AlbumArtFocusNoise.shadergraph?fileID=-876546973899608171&amp;guid=022ddc06c558bc94dac303d04b65435c&amp;type=3#AlbumArtFocusNoise&quot;) prop(&quot;_Color&quot; rgb(0, 0, 0)) prop(&quot;_DarkBoost&quot; 0.41); position: absolute; top: -1px; right: 3px; bottom: 3px; left: -2px; background-color: rgb(0, 0, 0);"/>
        <ui:VisualElement name="TopBar" style="height: 40px; width: 100%; background-color: rgba(0, 0, 0, 0.722);"/>
        <AccentButton name="Exit" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=315903273&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_9" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 40px; height: 40px; position: absolute;"/>
        <ui:VisualElement name="MainView" style="flex-grow: 1;">
            <ui:VisualElement>
                <ui:Image name="AlbumArt" style="background-image: url(&quot;project://database/Assets/MusicPlayer/DefaultIconDark.png?fileID=2800000&amp;guid=543b5d9d9baf7504ebeea8e602471298&amp;type=3#DefaultIconDark&quot;); aspect-ratio: 1; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; width: 500px; height: 1965px; -unity-material: url(&quot;project://database/Assets/MusicPlayer/Shaders/AlbumFocusImage.mat?fileID=2100000&amp;guid=306ba6b74d3bd4e4b86009f5a42e686c&amp;type=2#AlbumFocusImage&quot;) prop(&quot;_BlurAmount&quot; 0.3);"/>
                <ui:VisualElement name="ControlsAndInfo" style="flex-direction: row;">
                    <ui:VisualElement name="Controls">
                        <ui:VisualElement name="Buttons" style="flex-direction: row;">
                            <AccentButton name="Previous" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=-775752643&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_7" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px;"/>
                            <AccentButton name="Play" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=935154823&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_4" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px;"/>
                            <AccentButton name="Next" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=120335479&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_6" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px;"/>
                        </ui:VisualElement>
                        <ui:Slider value="0.3" name="VolumeSlider" high-value="1" fill="true"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Info" style="flex-grow: 1;">
                        <ui:Label text="No Artist" name="Artist" style="font-size: 20px; color: rgb(176, 176, 176); -unity-text-align: lower-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                        <ui:Label text="Nothing Playing" name="Title" style="font-size: 30px; bottom: 0; -unity-text-align: lower-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                        <ui:Label text="No Album" name="Album" style="font-size: 20px; color: rgb(176, 176, 176); -unity-text-align: lower-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
