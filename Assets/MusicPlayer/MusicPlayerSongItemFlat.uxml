<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MusicPlayer/MusicPlayerStyling.uss?fileID=7433441132597879392&amp;guid=e31be3d781b4572418858f823860acfb&amp;type=3#MusicPlayerStyling"/>
    <engine:VisualElement name="Background" style="flex-direction: row; flex-grow: 1;">
        <AccentButton icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=935154823&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_4" name="thumbnailPlayButton" style="background-color: rgba(0, 0, 0, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin-top: 15px; margin-right: 15px; margin-bottom: 15px; margin-left: 15px;"/>
        <engine:VisualElement name="SongInformation" style="flex-grow: 1; flex-direction: column;">
            <engine:Label text="Label" name="title" style="flex-shrink: 1; flex-grow: 2; color: rgb(255, 255, 255); align-self: stretch; flex-basis: 0; font-size: 40px; -unity-text-align: middle-left;"/>
            <engine:Label text="Label" name="artist" style="flex-shrink: 1; flex-grow: 1; color: rgba(255, 255, 255, 0.49); flex-basis: 0; -unity-text-align: middle-left; font-size: 23px;"/>
            <engine:Label text="Label" name="duration" style="flex-shrink: 1; flex-grow: 1; color: rgba(255, 255, 255, 0.49); flex-basis: 0; -unity-text-align: middle-left; font-size: 20px;"/>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
