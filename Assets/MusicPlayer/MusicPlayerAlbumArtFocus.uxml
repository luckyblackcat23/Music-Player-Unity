<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MusicPlayer/MusicPlayerStyling.uss?fileID=7433441132597879392&amp;guid=e31be3d781b4572418858f823860acfb&amp;type=3#MusicPlayerStyling"/>
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="Black" style="flex-grow: 1; position: absolute; background-color: rgb(0, 0, 0); flex-shrink: 0; right: 0; left: 0; bottom: 0; top: 0; display: none;"/>
        <ui:VisualElement name="Background" class="FocusShaderBackground" style="flex-grow: 1; -unity-material: url(&quot;project://database/Assets/MusicPlayer/Shaders/Shader%20Graphs_AlbumArtFocusNoise.mat?fileID=2100000&amp;guid=ced7292d8be54c64190ecce1b5f0858a&amp;type=2#Shader Graphs_AlbumArtFocusNoise&quot;); position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgb(0, 0, 0);"/>
        <AccentButton name="Exit" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=315903273&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_9" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px; position: absolute;"/>
        <ui:VisualElement name="MainView" style="flex-grow: 1; flex-direction: row; margin-top: 100px; margin-right: 100px; margin-bottom: 100px; margin-left: 100px;">
            <ui:VisualElement style="flex-basis: 50%; flex-shrink: 1; flex-grow: 1;">
                <ui:Image name="AlbumArt" style="background-image: url(&quot;project://database/Assets/MusicPlayer/DefaultIconDark.png?fileID=2800000&amp;guid=543b5d9d9baf7504ebeea8e602471298&amp;type=3#DefaultIconDark&quot;); flex-grow: 1; width: auto; height: 100%; aspect-ratio: 1; align-self: center; margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px;"/>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-self: center; align-items: flex-end; height: 82px;">
                    <AccentButton name="Previous" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=-775752643&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_7" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px;"/>
                    <AccentButton name="Play" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=935154823&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_4" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px;"/>
                    <AccentButton name="Next" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=120335479&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_6" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px;"/>
                </ui:VisualElement>
