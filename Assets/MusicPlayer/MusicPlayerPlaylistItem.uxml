<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MusicPlayer/MusicPlayerSongItemStyling.uss?fileID=7433441132597879392&amp;guid=88d9871614c64f142bc90309df6cdfae&amp;type=3#MusicPlayerSongItemStyling"/>
    <engine:VisualElement name="Background" style="margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; justify-content: center;">
        <engine:VisualElement name="albumArt" style="background-color: rgb(0, 0, 0); width: 80px; height: 80px; justify-content: center; flex-shrink: 0;">
            <engine:Button name="thumbnailPlayButton" style="width: 100%; height: 100%; background-color: rgba(188, 188, 188, 0); align-self: center; flex-grow: 1;"/>
        </engine:VisualElement>
        <engine:Label text="Label" name="title" style="flex-grow: 1; color: rgb(255, 255, 255); font-size: 19px; -unity-text-align: middle-left; flex-shrink: 1;"/>
    </engine:VisualElement>
</engine:UXML>
