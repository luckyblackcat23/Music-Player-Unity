<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/MusicPlayer/MusicPlayer.uss?fileID=7433441132597879392&amp;guid=e31be3d781b4572418858f823860acfb&amp;type=3#MusicPlayer"/>
    <ui:VisualElement name="Panel" class="panel" style="background-color: rgba(0, 0, 0, 0); flex-grow: 1; flex-direction: column-reverse;">
        <ui:VisualElement name="VisualElement" style="flex-direction: column-reverse; height: 150px; background-color: rgba(0, 0, 0, 0.8); flex-shrink: 1; flex-grow: 0; flex-basis: auto;">
            <ui:Slider value="44.3" high-value="100" fill="true" name="PlaybackSlider" style="height: 20px; min-height: 20px;"/>
            <ui:VisualElement name="VisualElement" style="flex-direction: row; height: 100%;">
                <ui:VisualElement name="AlbumArt" style="background-image: url(&quot;project://database/Assets/Packages/Kawazu.1.1.4/Kawazu_icon.png?fileID=2800000&amp;guid=a3863814fa7f9544eb7e0c2525d892e4&amp;type=3#Kawazu_icon&quot;); flex-direction: column-reverse; flex-wrap: nowrap; position: absolute; align-self: center; aspect-ratio: 1; flex-grow: 1; height: 100%;"/>
                <ui:VisualElement name="Buttons" style="flex-grow: 1; flex-shrink: 0; flex-direction: row; justify-content: center; align-self: center; top: -10px;">
                    <ui:Button text="" name="Loop" class="ButtonHover ButtonPressed" style="right: 50px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-image: url(&quot;project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=935751669&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_3&quot;); width: 70px; height: 70px;"/>
                    <ui:Button name="Previous" class="ButtonHover ButtonPressed" style="height: 70px; width: 70px; background-image: url(&quot;project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=-775752643&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_7&quot;); background-color: rgba(255, 255, 255, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button name="Play" class="ButtonHover ButtonPressed" style="height: 70px; width: 70px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(255, 255, 255, 0); background-image: url(&quot;project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=935154823&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_4&quot;);"/>
                    <ui:Button name="Next" class="ButtonHover ButtonPressed" style="height: 70px; width: 70px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=120335479&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_6&quot;);"/>
                    <ui:Button text="" name="Shuffle" class="ButtonHover ButtonPressed" style="height: 70px; width: 70px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=970811466&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_2&quot;); left: 50px;"/>
                </ui:VisualElement>
                <ui:Slider value="0.3" name="VolumeSlider" fill="true" high-value="1" style="position: absolute; align-self: flex-end; right: 0; left: auto; min-width: 300px; min-height: 48px;"/>
                <ui:Label text="Nothing Playing" enabled="true" name="SongTitle" style="position: absolute; bottom: 0; left: 150px; color: rgb(255, 255, 255); font-size: 30px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="VisualElement" style="background-color: rgba(0, 0, 0, 0.8); width: 20%;">
                <ui:TabView name="TabView" style="flex-grow: 1; width: 100%; height: 100%;">
                    <ui:Tab name="Queue" label="Queue" style="flex-grow: 1; flex-basis: auto;">
                        <ui:ListView name="SongQueue" reorderable="true" selection-type="Multiple" picking-mode="Position" class="panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);"/>
                    </ui:Tab>
                    <ui:Tab label="Playlists" name="Playlists" style="flex-grow: 1; flex-basis: auto;">
                        <ui:VisualElement style="background-color: rgb(255, 255, 255); width: 100%; height: 100%;"/>
                    </ui:Tab>
                    <ui:Tab label="Tab" name="Tab" style="flex-grow: 1; flex-basis: auto;">
                        <ui:VisualElement style="background-color: rgb(255, 255, 255); width: 100%; height: 100%;"/>
                    </ui:Tab>
                </ui:TabView>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.9);">
                <ui:TextField placeholder-text="..." name="SearchBar" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                <ui:ListView name="SongList" class="panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
