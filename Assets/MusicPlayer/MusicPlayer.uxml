<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/MusicPlayer/MusicPlayerStyling.uss?fileID=7433441132597879392&amp;guid=e31be3d781b4572418858f823860acfb&amp;type=3#MusicPlayerStyling"/>
    <ui:VisualElement name="Panel" class="accentBackgroundColor" style="flex-grow: 1; flex-direction: column-reverse; -unity-font-definition: url(&quot;project://database/Assets/MusicPlayer/DotGothic16-Regular.ttf?fileID=12800000&amp;guid=8feed8489bdd90b4196f246200e42d0a&amp;type=3#DotGothic16-Regular&quot;); -unity-font-style: normal;">
        <ui:VisualElement name="ControlBar" class="Panel" style="flex-direction: column-reverse; height: 150px; flex-shrink: 0; flex-grow: 0; flex-basis: auto; background-color: rgba(0, 0, 0, 0.69);">
            <ui:VisualElement name="Bottom" style="flex-grow: 1; flex-direction: row; height: 30px;">
                <ui:Label text="00:00" name="PlaybackTime" style="width: 60px; -unity-text-align: middle-left;"/>
                <ui:Slider value="0" high-value="100" fill="true" name="PlaybackSlider" style="height: 20px; min-height: 20px; flex-grow: 1; align-self: center;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Top" style="flex-direction: row; height: 120px;">
                <ui:VisualElement name="AlbumArt" style="flex-direction: column-reverse; flex-wrap: nowrap; position: absolute; align-self: center; aspect-ratio: 1; flex-grow: 1; height: 120px; background-image: url(&quot;project://database/Assets/MusicPlayer/DefaultIconDark.png?fileID=2800000&amp;guid=543b5d9d9baf7504ebeea8e602471298&amp;type=3#DefaultIconDark&quot;); bottom: 0;"/>
                <ui:VisualElement name="Buttons" style="flex-grow: 0; flex-shrink: 0; flex-direction: row; justify-content: center; align-self: center; top: -10px; position: relative; left: 50%; right: 50%;">
                    <AccentButton name="Previous" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=-775752643&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_7" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px;"/>
                    <AccentButton name="Play" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=935154823&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_4" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px;"/>
                    <AccentButton name="Next" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=120335479&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_6" class="ButtonHover ButtonPressed" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 70px; height: 70px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="SongInformation" style="flex-grow: 1; bottom: 0; left: 150px; position: absolute; flex-shrink: 1;">
                    <ui:Label text="No Artist" enabled="true" name="SongArtist" style="color: rgb(176, 176, 176); font-size: 20px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 30px; -unity-text-align: lower-left;"/>
                    <ui:Label text="Nothing Playing" enabled="true" name="SongTitle" style="color: rgb(255, 255, 255); font-size: 30px; flex-shrink: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 40px; -unity-text-align: lower-left;"/>
                </ui:VisualElement>
                <ui:Slider value="0.3" name="VolumeSlider" high-value="1" fill="true" style="position: absolute; align-self: flex-end; right: 0; left: auto; min-width: 300px; min-height: 48px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MainView" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="PopOutView" class="Panel" style="width: 20%; background-color: rgba(0, 0, 0, 0.55); display: flex;">
                <ui:TabView name="TabView" style="flex-grow: 1; width: 100%; height: 100%;">
                    <ui:Tab name="Queue" label="Queue" style="flex-grow: 1; flex-basis: auto;">
                        <ui:VisualElement style="flex-grow: 0; flex-direction: row; flex-shrink: 0;">
                            <AccentButton name="Shuffle" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=970811466&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_2" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(0, 0, 0, 0);"/>
                            <AccentButton name="Loop" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=935751669&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_3" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(0, 0, 0, 0);"/>
                            <ui:TextField label="" placeholder-text="filler text" name="SearchBarQueue" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;"/>
                        </ui:VisualElement>
                        <ui:ListView name="SongQueue" reorderable="true" selection-type="Multiple" picking-mode="Position" class="panel" style="flex-grow: 1;"/>
                    </ui:Tab>
                    <ui:Tab label="Playlists" name="Playlists" style="flex-grow: 1; flex-basis: auto;">
                        <ui:VisualElement style="flex-grow: 0; flex-direction: row; flex-shrink: 0;">
                            <AccentButton name="PlaylistListBack" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=897902550&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_8" style="background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                            <ui:TextField label="" placeholder-text="filler text" name="SearchBarPlaylists" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;"/>
                        </ui:VisualElement>
                        <ui:ListView name="PlaylistList"/>
                    </ui:Tab>
                </ui:TabView>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.39);">
                <ui:VisualElement name="VisualElement" style="flex-grow: 0; flex-direction: row;">
                    <AccentButton name="ShuffleAll" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=970811466&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_2" text="" class="ButtonHover ButtonPressed" style="width: 210px; height: 50px; align-self: center; border-left-color: rgb(100, 100, 100); border-right-color: rgb(100, 100, 100); border-top-color: rgb(100, 100, 100); border-bottom-color: rgb(100, 100, 100); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; font-size: 21px; -unity-text-align: middle-right; flex-direction: column-reverse; overflow: visible;">
                        <ui:Label text="Shuffle &amp; play" style="flex-grow: 1; font-size: 21px; padding-left: 40px; flex-shrink: 1; display: flex; position: absolute; top: 0; left: 11px; bottom: 0;"/>
                    </AccentButton>
                    <ui:TextField placeholder-text="..." name="SearchBar" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-grow: 1; align-self: stretch; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;"/>
                </ui:VisualElement>
                <ui:ListView name="SongList" class="panel" style="flex-grow: 1;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TopBar" style="height: 40px; flex-shrink: 0; background-color: rgba(0, 0, 0, 0.549);">
            <ui:VisualElement style="background-color: rgba(50, 50, 50, 0.392); height: 40px;">
                <AccentButton name="SettingsButton" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=483678747&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_11" style="flex-shrink: 1; height: 36px; aspect-ratio: 1; right: 0; position: absolute; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(0, 0, 0, 0);"/>
                <AccentButton name="PopOutButton" icon-image="project://database/Assets/MusicPlayer/Sprites/MusicPlayerUIAssets.png?fileID=897902550&amp;guid=dde93689df3044747a6adfd581d9ae89&amp;type=3#MusicPlayerUIAssets_8" style="height: 36px; flex-shrink: 1; left: 0; position: absolute; aspect-ratio: 1; background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
